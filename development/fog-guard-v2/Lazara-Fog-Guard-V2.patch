new file mode 100644
index 0000000..aac45e1
--- /dev/null
+++ b/tools/package_fog_guard.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Package only Fog Guard V2 and its exact include closure for a manual retest."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+from zipfile import ZipFile, ZIP_DEFLATED
+
+ROOT=Path(__file__).resolve().parents[1]
+EFFECT=ROOT/'reshade-shaders/Shaders/vendor/occult_box/black_wand/effects/BlackWand_10_FogLight_Guard.fx'
+
+
+def closure():
+    pending=[EFFECT];seen=set()
+    while pending:
+        path=pending.pop().resolve()
+        if path in seen:continue
+        if not path.is_relative_to(ROOT) or not path.is_file():raise ValueError(f'Missing/escaping include: {path}')
+        seen.add(path)
+        for name in re.findall(r'^\s*#include\s+"([^"]+)"',path.read_text(),re.M):
+            if name=='ReShade.fxh':continue
+            pending.append(path.parent/name.replace('\\','/'))
+    return sorted(seen)
+
+
+def package(output):
+    paths=closure()
+    assert [p.name for p in paths if p.suffix=='.fx']==[EFFECT.name]
+    revision=subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip()
+    # Keep the source revision meaningful: artifact files may be dirty, shader
+    # and included documentation/provenance must match the recorded commit.
+    frozen=[str(p.relative_to(ROOT)) for p in paths]+['FOG_GUARD_V2.md','patches/fog-guard-v2.patch','dependencies.lock.json']
+    subprocess.run(['git','diff','--exit-code','HEAD','--',*frozen],cwd=ROOT,check=True,capture_output=True)
+    manifest={'schema':'lazara-fog-guard-test-package-v1','source_revision':revision,
+              'effect_count':1,'techniques':['BlackWand_FogLight_Guard','BlackWand_FogLight_GuardRestore'],
+              'shader_file_count':len(paths),'external_dependencies':['ReShade.fxh'],
+              'native_compile_performed':False,'live_visual_test_performed':False,
+              'files':{p.relative_to(ROOT).as_posix():hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}}
+    lock=json.loads((ROOT/'dependencies.lock.json').read_text())
+    vendor=next(v for v in lock['vendored_sources'] if v['vendor_path'].endswith('/occult_box'))
+    provenance={'source_repository':vendor['repository'],'baseline_commit':vendor['commit'],
+                'local_patches':vendor['local_patches'],'scope':'Only the Fog Guard effect and unchanged include closure'}
+    payload={p.relative_to(ROOT).as_posix():p.read_bytes() for p in paths}
+    payload.update({'README.md':(ROOT/'FOG_GUARD_V2.md').read_bytes(),
+                    'patches/fog-guard-v2.patch':(ROOT/'patches/fog-guard-v2.patch').read_bytes(),
+                    'LICENSES/VENDORED-SOURCE-NOTICE.md':(ROOT/'LICENSES/VENDORED-SOURCE-NOTICE.md').read_bytes(),
+                    'PACKAGE_MANIFEST.json':(json.dumps(manifest,indent=2)+'\n').encode(),
+                    'SOURCE_PROVENANCE.json':(json.dumps(provenance,indent=2)+'\n').encode()})
+    output.parent.mkdir(parents=True,exist_ok=True)
+    with output.open('xb') as stream, ZipFile(stream,'w',compression=ZIP_DEFLATED) as archive:
+        for name,data in sorted(payload.items()):archive.writestr(name,data)
+    print(json.dumps({'output':str(output),'source_revision':revision,'shader_files':len(paths),
+                      'sha256':hashlib.sha256(output.read_bytes()).hexdigest()},indent=2))
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--output',type=Path,required=True)
+    package(parser.parse_args().output)
