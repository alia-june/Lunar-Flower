+ BWBlackWandX_Guard_MaskSoftening=.5f;colorMode=0;
+ referencePixel=captured;
+ for(uint frame: {0u,1u,65535u,65536u,16777215u,16777216u,16777217u,4294967295u}){
+  BWBlackWandX_Guard_FrameCount=frame;statePixel=BWBlackWandX_Guard_Stamp_PS(pos,uv);
+  check(BWBlackWandX_Guard_CurrentCapture(statePixel)==1,"current frame rejected");
+  BWBlackWandX_Guard_FrameCount=frame+1;
+  check(BWBlackWandX_Guard_CurrentCapture(statePixel)==0,"stale frame accepted at integer precision boundary");
+ }
+ BWBlackWandX_Guard_FrameCount=42;statePixel={0,0,0,0};sourceColor={.1f,.2f,.3f};referenceReads=0;
+ check(same(BWBlackWandX_Guard_Restore_PS(pos,uv).rgb(),sourceColor)&&referenceReads==0,"uninitialized capture changed output or read stale RGB");
+ statePixel=BWBlackWandX_Guard_FrameStamp();statePixel.z+=1;
+ check(same(BWBlackWandX_Guard_Restore_PS(pos,uv).rgb(),sourceColor),"dimension mismatch accepted");
+ statePixel=BWBlackWandX_Guard_FrameStamp();referencePixel={.5f,.6f,.7f,1};
+ auto restored=BWBlackWandX_Guard_Restore_PS(pos,uv);
+ check(restored.x>sourceColor.x&&restored.x<referencePixel.x,"late restore did not recover protected fog");
+ referencePixel.a=0;check(same(BWBlackWandX_Guard_Restore_PS(pos,uv).rgb(),sourceColor),"unprotected output changed");
+ BWBlackWandX_Guard_Strength=0;stateReads=referenceReads=0;
+ check(same(BWBlackWandX_Guard_Restore_PS(pos,uv).rgb(),sourceColor)&&stateReads==0&&referenceReads==0,"zero strength failed exact cheap bypass");
+ BWBlackWandX_Guard_Strength=1;BWBlackWandX_Guard_ProtectAmount=0;
+ check(same(BWBlackWandX_Guard_Restore_PS(pos,uv).rgb(),sourceColor),"zero protection changed source");
+ BWBlackWandX_Guard_ProtectAmount=.85f;
+ for(int i=0;i<=100;++i)for(int j=0;j<=100;++j){
+  float a=(float)i/100,b=(float)j/100;
+  auto out=BWBlackWandX_Guard_RestoreColor({a,b,a},{b,a,b},a);
+  check(out.x>=min(a,b)-.000001f&&out.x<=max(a,b)+.000001f,"restore exceeds the source/reference interval");
+ }
+ colorMode=1;linearDepth=.02f;float previous=-1;
+ for(int i=0;i<=1024;++i){
+  float2 p(.25f+(float)i/2048,.5f);
+  auto e=BWBlackWandX_Guard_Measure(p);float m=BWBlackWandX_Guard_SoftMask(p,e);
+  check(m>=0&&m<=1,"soft mask out of bounds");
+  if(previous>=0)check(abs(m-previous)<.001f,"smooth camera sweep produced mask jumps");previous=m;
+ }
+ std::cout<<"PASS: "<<assertions<<" Fog Guard shader-extracted assertions; neutral capture, fine mask, depth/fog bounds, late restore, stale-frame rejection and camera sweep.\n";
+}catch(const std::exception& e){std::cerr<<"FAIL: "<<e.what()<<"\n";return 1;}}
+'''
+
+
+def shader_cpp():
+    s=EFFECT.read_text();s=s[s.index('uniform int BWBlackWandX_Guard_DebugView'):s.index('\ntechnique BlackWand_FogLight_Guard\n')]
+    s=re.sub(r'uniform\s+(int|float)\s+(\w+)\s*<.*?>\s*=\s*([^;]+);',r'\1 \2 = \3;',s,flags=re.S)
+    s=re.sub(r'uniform uint (\w+)\s*<.*?>;',r'uint \1=0;',s,flags=re.S)
+    s=re.sub(r'(?:texture2D|sampler2D)\s+\w+\s*\{.*?\};','',s,flags=re.S)
+    s=re.sub(r'\s*:\s*(?:SV_Position|SV_Target|TEXCOORD)\b','',s)
+    s=s.replace('.rgb','.rgb()')
+    s=re.sub(r'\b(\d+\.\d+)(?![\w.])',r'\1f',s)
+    return SHIM+s+CASES
+
+
+class FogGuardTests(unittest.TestCase):
+    @unittest.skipUnless(shutil.which('c++'),'requires a C++17 compiler')
+    def test_actual_shader_math_and_pass_entrypoints(self):
+        with tempfile.TemporaryDirectory(prefix='fog-guard-fixture-') as tmp:
+            src=Path(tmp)/'fixture.cpp';src.write_text(shader_cpp());exe=Path(tmp)/'fixture'
+            r=subprocess.run(['c++','-std=c++17','-O2',str(src),'-o',str(exe)],text=True,capture_output=True)
+            self.assertEqual(r.returncode,0,r.stderr)
+            r=subprocess.run([str(exe)],text=True,capture_output=True)
+            self.assertEqual(r.returncode,0,r.stdout+r.stderr)
+            print(r.stdout,end='')
+
+    def test_local_guard_and_preset_contract(self):
+        s=EFFECT.read_text();preset=(ROOT/'Lazara.ini').read_text()
+        techniques=next(l.split('=',1)[1] for l in preset.splitlines() if l.startswith('Techniques=')).split(',')
+        capture='BlackWand_FogLight_Guard@BlackWand_10_FogLight_Guard.fx'
+        restore='BlackWand_FogLight_GuardRestore@BlackWand_10_FogLight_Guard.fx'
+        self.assertEqual(techniques.count(capture),1);self.assertEqual(techniques.count(restore),1)
+        self.assertLess(techniques.index(capture),techniques.index(restore));self.assertEqual(techniques[-1],restore)
+        self.assertNotIn('black_wand_Proc_DepthValue(',s)
+        self.assertNotRegex(s,r'\b(?:tex2D|tex2Dbias|ddx|ddy|fwidth)\s*\(')
+        self.assertIn('Width = BUFFER_WIDTH; Height = BUFFER_HEIGHT; Format = RGBA16F;',s)
+        self.assertEqual(len(re.findall(r'^technique\s+',s,re.M)),2)
+
+if __name__=='__main__':unittest.main()
