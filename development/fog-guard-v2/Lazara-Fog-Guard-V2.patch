+    float wd = BWBlackWandX_Guard_TapWeight(center, d);
+    float mask = (center.mask * 2.0 + a.mask * wa + b.mask * wb + c.mask * wc + d.mask * wd) / (2.0 + wa + wb + wc + wd);
+    return saturate(lerp(center.mask, mask, saturate(BWBlackWandX_Guard_MaskSoftening)));
+}
+
+float4 BWBlackWandX_Guard_Capture_PS(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
+{
